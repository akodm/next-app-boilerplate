FROM node:24

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN apt update && apt install -y git vim less zsh fzf wget

RUN corepack enable && corepack prepare pnpm@10.28.0 --activate

WORKDIR /app/next-app-boilerplate

COPY package.json pnpm-lock.yaml ./

RUN pnpm install --frozen-lockfile

COPY . .

CMD ["pnpm", "dev"]
